#!/usr/bin/env bash
#
# yx-test-guard — assert that tests actually RAN, not merely that mix exited 0.
#
# WHY THIS EXISTS
#
#   $ mix test test/nonexistent
#   $ echo $?
#   0
#   $ # ...and zero tests ran. No summary line. No warning. Clean exit.
#
# An exit status cannot distinguish "everything passed" from "nothing was
# selected". Neither can it distinguish "the Yjs oracle ran and agreed" from
# "the oracle was missing so its module was skipped" — which is the failure
# this repository cares about most, because the conformance suite is the whole
# reason to trust the library's wire compatibility.
#
# ⛔ THE RULE THIS ENCODES: assert the COUNT, never an exit code.
#
# Ported from commonplace's bin/cp-test-guard, which was written after a
# reviewer read "390 tests, 0 failures" and missed the "11 invalid" beside it.
# Kept deliberately small: this repo has one app, so there is one summary line.
#
# USAGE
#
#   bin/yx-test-guard --min 412 -- mix test
#   bin/yx-test-guard --exact 11 -- mix test test/yelixer/diff_yjs_test.exs --include diff_yjs
#   bin/yx-test-guard --exact 17 --expect-failures 7 -- mix test --include divergence ...
#
# --min   at least N tests must have EXECUTED (not merely been defined --
#         see the executed-count note below; this is the DEFAULT so a caller
#         who knows nothing about the distinction still gets the right
#         population. An opt-in correction is a remembered rule wearing a
#         script's clothes.)
# --exact the run must report exactly N tests (use where the suite is a fixed,
#         known set — a conformance matrix that silently shrinks is the defect)
# --expect-failures
#         the run must report exactly N failures, and the guard then exits 0.
#         For a RED-BY-DESIGN population: the :divergence job pins measured
#         parity bugs that are not yet fixed, so its correct state is red, and
#         the number of reds is the assertion.
#
#         ⭐ This is not "ignore failures" — it is the same rule pointed the
#         other way. A divergence that silently starts PASSING is a signal
#         (someone fixed it, or the case stopped being able to fail), and only
#         an exact failure count can see that. Both directions are errors here.
#
# The wrapped command's exit status is preserved when the guard passes, except
# under --expect-failures, where meeting the expected count IS the pass.

set -uo pipefail

MIN=""
EXACT=""
EXPECT_FAILURES=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --min) MIN="$2"; shift 2 ;;
    --exact) EXACT="$2"; shift 2 ;;
    --expect-failures) EXPECT_FAILURES="$2"; shift 2 ;;
    --) shift; break ;;
    *) echo "yx-test-guard: unexpected argument '$1' (did you forget '--'?)" >&2; exit 64 ;;
  esac
done

if [[ $# -eq 0 ]]; then
  echo "yx-test-guard: no command given. usage: yx-test-guard --min N -- mix test ..." >&2
  exit 64
fi

OUT="$(mktemp -t yx-test-guard.XXXXXX)"
trap 'rm -f "$OUT"' EXIT

"$@" >"$OUT" 2>&1
CMD_RC=$?
cat "$OUT"

TOTAL=0
FOUND=0
while read -r n; do TOTAL=$((TOTAL + n)); FOUND=1; done \
  < <(grep -oE '[0-9]+ tests?,' "$OUT" | grep -oE '[0-9]+')

if [[ "$FOUND" -eq 0 ]]; then
  echo "" >&2
  echo "yx-test-guard: FAILED — no ExUnit summary line was emitted." >&2
  echo "  The command exited ${CMD_RC}, but nothing ran. A zero-selection run" >&2
  echo "  is a failure here, not a pass." >&2
  echo "  Command: $*" >&2
  exit 1
fi

# ⛔ INVALIDATED TESTS ARE NOT A PASS WITH A FOOTNOTE. ExUnit prints
# "N tests, 0 failures, N invalid" when a setup_all raises: literally true,
# reads green, and nothing in those modules ran.
INVALID=0
while read -r n; do INVALID=$((INVALID + n)); done \
  < <(grep -oE '[0-9]+ invalid' "$OUT" | grep -oE '[0-9]+')
if [[ "$INVALID" -gt 0 ]]; then
  echo "" >&2
  echo "yx-test-guard: FAILED — ${INVALID} test(s) INVALIDATED; coverage unknown." >&2
  echo "  Command: $*" >&2
  exit 1
fi

# ⛔ A SKIPPED CONFORMANCE MODULE IS THE FAILURE THIS REPO MOST NEEDS TO SEE.
# The oracle suite skips itself when the Yjs driver is absent, which is correct
# locally and a silent hole in CI. CI sets YELIXER_REQUIRE_YJS_ORACLE=1 so the
# skip becomes a raise; this is the second line of defence if that is dropped.
SKIPPED=0
while read -r n; do SKIPPED=$((SKIPPED + n)); done \
  < <(grep -oE '[0-9]+ skipped' "$OUT" | grep -oE '[0-9]+')
if [[ -n "$EXACT" && "$SKIPPED" -gt 0 ]]; then
  echo "" >&2
  echo "yx-test-guard: FAILED — ${SKIPPED} test(s) SKIPPED in an exact-count run." >&2
  echo "  An exact count is used where the set is fixed and fully required;" >&2
  echo "  a skip there means the environment silently dropped coverage." >&2
  echo "  Command: $*" >&2
  exit 1
fi

if [[ -n "$EXACT" && "$TOTAL" -ne "$EXACT" ]]; then
  echo "" >&2
  echo "yx-test-guard: FAILED — expected exactly ${EXACT} tests, saw ${TOTAL}." >&2
  echo "  If the suite legitimately changed, update the number DELIBERATELY in" >&2
  echo "  the commit that changed it. Do not adjust it to get green." >&2
  echo "  Command: $*" >&2
  exit 1
fi

# ⛔ EXCLUDED TESTS ARE DEFINED, NOT RUN — AND ExUnit COUNTS THEM IN "N tests".
# "411 tests, 0 failures, 17 excluded" means 394 executed. Comparing a floor
# against the DEFINED count would let the floor be satisfied by tests that
# never ran, which is the very substitution this guard exists to refuse. The
# floor is therefore checked against EXECUTED = TOTAL - EXCLUDED.
# Executed = (tests + doctests) − excluded − skipped.
# ⛔ THE DOCTEST TERM IS NOT DECORATION: ExUnit's "N doctests, M tests" are
# DISJOINT counts and "excluded" spans BOTH. Omitting it undercounts by the
# doctest count and makes a CORRECT floor read as red. Skipped must come off
# for the same reason excluded does — a skip did not run either.
# (Formula and its measurement are commonplace's bin/cp-test-guard, 2026-08-18;
# this repo's copy was ported before that fix and lost it.)
DOCTESTS=0
while read -r n; do DOCTESTS=$((DOCTESTS + n)); done \
  < <(grep -oE '[0-9]+ doctests?,' "$OUT" | grep -oE '[0-9]+')
EXCLUDED=0
while read -r n; do EXCLUDED=$((EXCLUDED + n)); done \
  < <(grep -oE '[0-9]+ excluded' "$OUT" | grep -oE '[0-9]+')
SKIPPED_N=0
while read -r n; do SKIPPED_N=$((SKIPPED_N + n)); done \
  < <(grep -oE '[0-9]+ skipped' "$OUT" | grep -oE '[0-9]+')
EXECUTED=$((TOTAL + DOCTESTS - EXCLUDED - SKIPPED_N))

if [[ -n "$MIN" && "$EXECUTED" -lt "$MIN" ]]; then
  echo "" >&2
  echo "yx-test-guard: FAILED — expected at least ${MIN} tests to RUN, saw ${EXECUTED} (${TOTAL} tests + ${DOCTESTS} doctests − ${EXCLUDED} excluded − ${SKIPPED_N} skipped)." >&2
  echo "  If the suite legitimately shrank, lower this DELIBERATELY in the" >&2
  echo "  commit that shrank it. Do not lower it to get green." >&2
  echo "  Command: $*" >&2
  exit 1
fi

if [[ -n "$EXPECT_FAILURES" ]]; then
  FAILURES=0
  while read -r n; do FAILURES=$((FAILURES + n)); done \
    < <(grep -oE '[0-9]+ failures?' "$OUT" | grep -oE '[0-9]+')

  if [[ "$FAILURES" -ne "$EXPECT_FAILURES" ]]; then
    echo "" >&2
    echo "yx-test-guard: FAILED — expected exactly ${EXPECT_FAILURES} failure(s), saw ${FAILURES}." >&2
    if [[ "$FAILURES" -lt "$EXPECT_FAILURES" ]]; then
      echo "  FEWER reds than expected. Either a divergence was FIXED — restate" >&2
      echo "  the count in the commit that fixed it, and say which case retired —" >&2
      echo "  or a case stopped being able to fail, which is a VACUOUS arm and is" >&2
      echo "  worse than a red one: it looks exactly like coverage in a count." >&2
    else
      echo "  MORE reds than expected. A new divergence appeared, or a case that" >&2
      echo "  was passing regressed. Do not raise this number to get green." >&2
    fi
    echo "  Command: $*" >&2
    exit 1
  fi

  echo "yx-test-guard: ${TOTAL} test(s) ran${EXACT:+ (exact ${EXACT})}, ${FAILURES} failure(s) (expected ${EXPECT_FAILURES}, RED BY DESIGN), 0 invalid"
  exit 0
fi

echo "yx-test-guard: ${EXECUTED} test(s) ran${EXACT:+ (exact ${EXACT})}${MIN:+ (floor ${MIN})}${EXCLUDED:+, ${EXCLUDED} excluded}, 0 invalid, command rc=${CMD_RC}"
exit "$CMD_RC"
