#!/usr/bin/env bash
#
# yx-test-guard — assert that tests actually RAN, not merely that mix exited 0.
#
# WHY THIS EXISTS
#
#   $ mix test test/nonexistent
#   $ echo $?
#   0
#   $ # ...and zero tests ran. No summary line. No warning. Clean exit.
#
# An exit status cannot distinguish "everything passed" from "nothing was
# selected". Neither can it distinguish "the Yjs oracle ran and agreed" from
# "the oracle was missing so its module was skipped" — which is the failure
# this repository cares about most, because the conformance suite is the whole
# reason to trust the library's wire compatibility.
#
# ⛔ THE RULE THIS ENCODES: assert the COUNT, never an exit code.
#
# Ported from commonplace's bin/cp-test-guard, which was written after a
# reviewer read "390 tests, 0 failures" and missed the "11 invalid" beside it.
# Kept deliberately small: this repo has one app, so there is one summary line.
#
# USAGE
#
#   bin/yx-test-guard --min 414 -- mix test
#   bin/yx-test-guard --exact 11 -- mix test test/yelixer/diff_yjs_test.exs --include diff_yjs
#   bin/yx-test-guard --exact 17 --expect-failures 5 -- mix test --include divergence ...
#
# --min   at least N tests must have EXECUTED (not merely been defined --
#         see the executed-count note below; this is the DEFAULT so a caller
#         who knows nothing about the distinction still gets the right
#         population. An opt-in correction is a remembered rule wearing a
#         script's clothes.)
# --exact the run must report exactly N tests (use where the suite is a fixed,
#         known set — a conformance matrix that silently shrinks is the defect)
# --expect-failures
#         the run must report exactly N failures, and the guard then exits 0.
#         For a RED-BY-DESIGN population: the :divergence job pins measured
#         parity bugs that are not yet fixed, so its correct state is red, and
#         the number of reds is the assertion.
#
#         ⭐ This is not "ignore failures" — it is the same rule pointed the
#         other way. A divergence that silently starts PASSING is a signal
#         (someone fixed it, or the case stopped being able to fail), and only
#         an exact failure count can see that. Both directions are errors here.
#
# The wrapped command's exit status is preserved when the guard passes, except
# under --expect-failures, where meeting the expected count IS the pass.

set -uo pipefail

MIN=""
EXACT=""
EXPECT_FAILURES=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --min) MIN="$2"; shift 2 ;;
    --exact) EXACT="$2"; shift 2 ;;
    --expect-failures) EXPECT_FAILURES="$2"; shift 2 ;;
    --) shift; break ;;
    *) echo "yx-test-guard: unexpected argument '$1' (did you forget '--'?)" >&2; exit 64 ;;
  esac
done

if [[ $# -eq 0 ]]; then
  echo "yx-test-guard: no command given. usage: yx-test-guard --min N -- mix test ..." >&2
  exit 64
fi

OUT="$(mktemp -t yx-test-guard.XXXXXX)"

# ⭐ SAMPLE THE BOX *DURING* THE RUN, NOT AT THE ENDS.
#
# Measured here 2026-08-27: a run's pre-flight read 4286 MB available and its
# post-run read 4351 MB -- both comfortable -- while 174 samples taken DURING
# it found a MINIMUM of 934 MB, far below the fleet's 1500 MB danger line.
# ⛔ A before-and-after pair would have certified a clean window that never
# existed. A pre-flight answers "may I start"; only sampling answers "what did
# my run do to the box", and that is the number a neighbour needs from you.
#
# In the guard rather than in each caller because a remembered rule does not
# fire: I hand-rolled this loop once and would have hand-rolled it again.
# ⛔ THREE VARIABLES, NOT ONE. Sampling `available` alone tells you WHAT
# happened and cannot tell you WHOSE -- measured here today: this repo reported
# a 934 MB minimum during its own run and took responsibility for it, and the
# dominant term was another process faulting ~2.5 GB back in. A 174-sample
# series of ONE variable still has one variable, and the discipline produced a
# FALSE CONFESSION because the variable that moved was not in the instrument.
#
# So also sample total BEAM residency (which captures a neighbouring long-lived
# BEAM oscillating -- one on this box has been measured swinging 2451 MB across
# five readings, same pid, exceeding the whole suite population) and the suite
# count. Enumerated by `comm` via pgrep -x, never by matching a string this
# script also contains.
SAMPLES="$(mktemp -t yx-test-guard-mem.XXXXXX)"
(
  while :; do
    avail=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo 2>/dev/null) || break
    beam_rss=0; suites=0
    for pp in $(pgrep -x beam.smp 2>/dev/null); do
      r=$(awk '/^VmRSS:/{print int($2/1024)}' "/proc/$pp/status" 2>/dev/null) && beam_rss=$((beam_rss + ${r:-0}))
      # ⛔ The REDIRECT fails before tr runs, so tr's own 2>/dev/null cannot
      # suppress it: a BEAM exiting between enumeration and this read printed
      # "/proc/NNN/cmdline: No such file or directory" INTO a captured run log.
      # Harmless to the count, but a sampler must not write noise into the
      # output someone reads for a verdict. Brace-group redirect covers both.
      cl=$({ tr '\0' ' ' < "/proc/$pp/cmdline"; } 2>/dev/null)
      case "$cl" in *"-extra"*"mix"*"test"*) suites=$((suites + 1));; esac
    done
    echo "$avail $beam_rss $suites"
    sleep 3
  done > "$SAMPLES"
) &
SAMPLER_PID=$!

# ⛔ ONE trap, extended -- a second `trap ... EXIT` SILENTLY REPLACES the first
# (measured elsewhere in the fleet today), which would leave the sampler alive
# or the tempfiles behind depending on which won.
# ⛔ EACH CLEANUP STEP IS EXPLICITLY NEUTRALISED (`|| :`), NOT MERELY SAFE
# BECAUSE `set -e` HAPPENS TO BE ABSENT ABOVE. Measured elsewhere in the fleet
# today: `kill` on an already-dead pid exits 1 and `wait` on a killed child
# exits 143, and under `set -e` either KILLS THE SCRIPT AFTER THE SUITES HAVE
# RUN AND BEFORE IT REPORTS THEM -- a cleanup defect wearing the costume of a
# gate refusal, which cost two landings there.
# We do not use `set -e`, so this is currently safe by the ABSENCE OF A FLAG --
# and adding `set -e` is the single most natural hardening anyone would later
# apply to this file. It would arm the trap SILENTLY. So the safety is written
# down rather than inherited from a line someone may "improve".
# THE CLEANUP OF A SAMPLER MUST NEVER BE ABLE TO FAIL THE RUN IT MEASURED.
trap 'kill "$SAMPLER_PID" 2>/dev/null || :; rm -f "$OUT" "$SAMPLES" 2>/dev/null || :' EXIT

"$@" >"$OUT" 2>&1
CMD_RC=$?
cat "$OUT"

# Minimum available memory observed DURING the run, with the sample count so a
# reader can tell "quiet box" from "instrument saw almost nothing".
box_note() {
  local n min_avail max_beam max_suites
  n=$(wc -l < "$SAMPLES" 2>/dev/null || echo 0)
  [ "$n" -gt 0 ] || { printf '%s' ", box: NOT SAMPLED"; return; }
  min_avail=$(awk '{print $1}' "$SAMPLES" | sort -n | head -1)
  max_beam=$(awk '{print $2}' "$SAMPLES" | sort -n | tail -1)
  max_suites=$(awk '{print $3}' "$SAMPLES" | sort -n | tail -1)
  # min available is the danger number; peak BEAM residency and peak suite
  # count are what make a dip ATTRIBUTABLE rather than arguable afterwards.
  printf '%s' ", box: min avail ${min_avail}MB / peak BEAM rss ${max_beam}MB / peak suites ${max_suites}, over ${n} samples"
}

TOTAL=0
FOUND=0
while read -r n; do TOTAL=$((TOTAL + n)); FOUND=1; done \
  < <(grep -oE '[0-9]+ tests?,' "$OUT" | grep -oE '[0-9]+')

if [[ "$FOUND" -eq 0 ]]; then
  echo "" >&2
  echo "yx-test-guard: FAILED — no ExUnit summary line was emitted." >&2
  echo "  The command exited ${CMD_RC}, but nothing ran. A zero-selection run" >&2
  echo "  is a failure here, not a pass." >&2
  echo "  Command: $*" >&2
  exit 1
fi

# ⛔ INVALIDATED TESTS ARE NOT A PASS WITH A FOOTNOTE. ExUnit prints
# "N tests, 0 failures, N invalid" when a setup_all raises: literally true,
# reads green, and nothing in those modules ran.
INVALID=0
while read -r n; do INVALID=$((INVALID + n)); done \
  < <(grep -oE '[0-9]+ invalid' "$OUT" | grep -oE '[0-9]+')
if [[ "$INVALID" -gt 0 ]]; then
  echo "" >&2
  echo "yx-test-guard: FAILED — ${INVALID} test(s) INVALIDATED; coverage unknown." >&2
  echo "  Command: $*" >&2
  exit 1
fi

# ⛔ A SKIPPED CONFORMANCE MODULE IS THE FAILURE THIS REPO MOST NEEDS TO SEE.
# The oracle suite skips itself when the Yjs driver is absent, which is correct
# locally and a silent hole in CI. CI sets YELIXER_REQUIRE_YJS_ORACLE=1 so the
# skip becomes a raise; this is the second line of defence if that is dropped.
SKIPPED=0
while read -r n; do SKIPPED=$((SKIPPED + n)); done \
  < <(grep -oE '[0-9]+ skipped' "$OUT" | grep -oE '[0-9]+')
if [[ -n "$EXACT" && "$SKIPPED" -gt 0 ]]; then
  echo "" >&2
  echo "yx-test-guard: FAILED — ${SKIPPED} test(s) SKIPPED in an exact-count run." >&2
  echo "  An exact count is used where the set is fixed and fully required;" >&2
  echo "  a skip there means the environment silently dropped coverage." >&2
  echo "  Command: $*" >&2
  exit 1
fi

# ⛔ EXCLUDED TESTS ARE DEFINED, NOT RUN — AND ExUnit COUNTS THEM IN "N tests".
# "411 tests, 0 failures, 17 excluded" means 394 executed. Comparing a floor
# against the DEFINED count would let the floor be satisfied by tests that
# never ran, which is the very substitution this guard exists to refuse. The
# floor is therefore checked against EXECUTED = TOTAL - EXCLUDED.
# Executed = (tests + doctests) − excluded − skipped.
# ⛔ THE DOCTEST TERM IS NOT DECORATION: ExUnit's "N doctests, M tests" are
# DISJOINT counts and "excluded" spans BOTH. Omitting it undercounts by the
# doctest count and makes a CORRECT floor read as red. Skipped must come off
# for the same reason excluded does — a skip did not run either.
# (Formula and its measurement are commonplace's bin/cp-test-guard, 2026-08-18;
# this repo's copy was ported before that fix and lost it.)
DOCTESTS=0
while read -r n; do DOCTESTS=$((DOCTESTS + n)); done \
  < <(grep -oE '[0-9]+ doctests?,' "$OUT" | grep -oE '[0-9]+')
EXCLUDED=0
while read -r n; do EXCLUDED=$((EXCLUDED + n)); done \
  < <(grep -oE '[0-9]+ excluded' "$OUT" | grep -oE '[0-9]+')
SKIPPED_N=0
while read -r n; do SKIPPED_N=$((SKIPPED_N + n)); done \
  < <(grep -oE '[0-9]+ skipped' "$OUT" | grep -oE '[0-9]+')
EXECUTED=$((TOTAL + DOCTESTS - EXCLUDED - SKIPPED_N))

# ⛔ AN EXCLUDED TEST IN AN EXACT-COUNT RUN IS THE SAME DEFECT AS A SKIPPED
# ONE, AND ExUnit COUNTS IT IN THE TOTAL. "12 tests, 5 excluded" means SEVEN
# ran, but a floor or an exact count compared against the summary's total sees
# 12 and passes. Measured on this repo 2026-08-27: the guard printed
# "7 test(s) ran (exact 12), 5 excluded" AND EXITED 0 -- announcing the
# contradiction in its own success line. "Excluded" and "ran" shared an
# observable inside the tool built to stop exactly that.
if [[ -n "$EXACT" && "$EXCLUDED" -gt 0 ]]; then
  echo "" >&2
  echo "yx-test-guard: FAILED — ${EXCLUDED} test(s) EXCLUDED in an exact-count run." >&2
  echo "  An exact count names a fixed, fully-required set; an exclusion there" >&2
  echo "  means the selection silently dropped members. If the exclusion is" >&2
  echo "  intended, add the tag filter that includes them, or assert the" >&2
  echo "  smaller set deliberately." >&2
  echo "  Command: $*" >&2
  exit 1
fi

if [[ -n "$EXACT" && "$EXECUTED" -ne "$EXACT" ]]; then
  echo "" >&2
  echo "yx-test-guard: FAILED — expected exactly ${EXACT} tests to RUN, saw ${EXECUTED} (${TOTAL} tests + ${DOCTESTS} doctests − ${EXCLUDED} excluded − ${SKIPPED_N} skipped)." >&2
  echo "  If the suite legitimately changed, update the number DELIBERATELY in" >&2
  echo "  the commit that changed it. Do not adjust it to get green." >&2
  echo "  Command: $*" >&2
  exit 1
fi

if [[ -n "$MIN" && "$EXECUTED" -lt "$MIN" ]]; then
  echo "" >&2
  echo "yx-test-guard: FAILED — expected at least ${MIN} tests to RUN, saw ${EXECUTED} (${TOTAL} tests + ${DOCTESTS} doctests − ${EXCLUDED} excluded − ${SKIPPED_N} skipped)." >&2
  echo "  If the suite legitimately shrank, lower this DELIBERATELY in the" >&2
  echo "  commit that shrank it. Do not lower it to get green." >&2
  echo "  Command: $*" >&2
  exit 1
fi

if [[ -n "$EXPECT_FAILURES" ]]; then
  FAILURES=0
  while read -r n; do FAILURES=$((FAILURES + n)); done \
    < <(grep -oE '[0-9]+ failures?' "$OUT" | grep -oE '[0-9]+')

  if [[ "$FAILURES" -ne "$EXPECT_FAILURES" ]]; then
    echo "" >&2
    echo "yx-test-guard: FAILED — expected exactly ${EXPECT_FAILURES} failure(s), saw ${FAILURES}." >&2
    if [[ "$FAILURES" -lt "$EXPECT_FAILURES" ]]; then
      echo "  FEWER reds than expected. Either a divergence was FIXED — restate" >&2
      echo "  the count in the commit that fixed it, and say which case retired —" >&2
      echo "  or a case stopped being able to fail, which is a VACUOUS arm and is" >&2
      echo "  worse than a red one: it looks exactly like coverage in a count." >&2
    else
      echo "  MORE reds than expected. A new divergence appeared, or a case that" >&2
      echo "  was passing regressed. Do not raise this number to get green." >&2
    fi
    echo "  Command: $*" >&2
    exit 1
  fi

  echo "yx-test-guard: ${TOTAL} test(s) ran${EXACT:+ (exact ${EXACT})}, ${FAILURES} failure(s) (expected ${EXPECT_FAILURES}, RED BY DESIGN), 0 invalid$(box_note)"
  exit 0
fi

echo "yx-test-guard: ${EXECUTED} test(s) ran${EXACT:+ (exact ${EXACT})}${MIN:+ (floor ${MIN})}${EXCLUDED:+, ${EXCLUDED} excluded}, 0 invalid, command rc=${CMD_RC}$(box_note)"
exit "$CMD_RC"
