#!/usr/bin/env bash
#
# bin/verify-upstream — drift check for the readable upstream source
# references against upstream-refs.json.
#
# THREE OUTCOMES, THREE DISTINCT EXIT CODES. Never a skip. Never a silent pass.
#
#   0  GREEN — every ref present, on-disk HEAD == the sha the manifest names.
#   1  RED   — a ref is present but at a DIFFERENT sha than the manifest names
#              (drift: someone moved the clone, or the manifest was bumped
#              and bin/fetch-upstream wasn't re-run).
#   2  BLIND — a ref the manifest names has no clone on disk at all. This is
#              NOT a pass and NOT a skip — a missing readable reference means
#              nobody can honestly cite it, which is exactly the state that
#              must be loud. (House rule: "a missing oracle must be RED, never
#              skipped" — applied to the readable half. Reported as its own
#              code, distinct from RED, because "wrong version" and "no
#              version" are different failures needing different fixes:
#              red needs `bin/fetch-upstream` to move a sha, blind needs it
#              to clone from nothing.)
#
# This script makes no network calls (see bin/fetch-upstream for the host-act
# fetch/checkout step). It only inspects what's already on disk.
#
# ⛔ NOTHING INVOKES THIS. It is PRESENT, its three arms (GREEN/RED/BLIND) were
# demonstrated on the real tree, and NO CI job and NO script calls it. Measured
# 2026-08-27 with a positive control (`git grep` finds yx-test-guard's real
# invocations in 3 files): every hit for `verify-upstream` at origin/main is
# this file talking about itself, plus one prose mention in fetch-upstream.
#
# That is a THIRD state, distinct from absent and from unreachable, and it
# greps GREENER than either -- the file exists and its arms are red-tested, so
# a reader concludes it is protecting them. A self-referential hit is still a
# hit, so "prefer hits over zeros" does not catch it; only reading the PATHS
# does.
#
# ⚠️ Deliberate, and stated so it is not mistaken for an oversight: CI has no
# clones to verify (they are gitignored, populated on the host), so wiring this
# into CI would make it BLIND on every run. It is a developer tool, run by hand
# before trusting a citation into yjs-stable/ or y-crdt/. Calling it a gate
# would be the decoration this repo has spent the day refusing.
#
# ⛔ If you wire it anywhere, the arm to demonstrate FIRST is BLIND (rc 2) --
# the one a CI checkout would hit every time.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="$REPO_ROOT/upstream-refs.json"

if [[ ! -f "$MANIFEST" ]]; then
  echo "verify-upstream: no manifest at $MANIFEST" >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "verify-upstream: jq is required" >&2
  exit 1
fi

count=$(jq '.refs | length' "$MANIFEST")
status=0   # 0=green so far
saw_red=0
saw_blind=0

for i in $(seq 0 $((count - 1))); do
  row=$(jq -c ".refs[$i]" "$MANIFEST")
  name=$(jq -r '.name' <<<"$row")
  path=$(jq -r '.path' <<<"$row")
  tag=$(jq -r '.tag' <<<"$row")
  sha=$(jq -r '.sha' <<<"$row")
  dest="$REPO_ROOT/$path"

  if [[ ! -d "$dest/.git" ]]; then
    echo "BLIND  $name ($tag): no clone at $path/ — cannot be read, cannot be cited. Run: bin/fetch-upstream $name"
    saw_blind=1
    continue
  fi

  have="$(git -C "$dest" rev-parse HEAD 2>/dev/null || echo "")"
  if [[ -z "$have" ]]; then
    echo "BLIND  $name ($tag): $path/ exists but is not a readable git checkout — Run: bin/fetch-upstream $name"
    saw_blind=1
    continue
  fi

  if [[ "$have" != "$sha" ]]; then
    echo "RED    $name: on-disk HEAD $have does not match manifest sha $sha ($tag). Run: bin/fetch-upstream $name"
    saw_red=1
    continue
  fi

  echo "GREEN  $name: $have matches manifest ($tag)"
done

if [[ "$saw_blind" -eq 1 ]]; then
  echo "verify-upstream: BLIND — at least one readable reference is missing on disk." >&2
  exit 2
fi
if [[ "$saw_red" -eq 1 ]]; then
  echo "verify-upstream: RED — at least one readable reference has drifted from the manifest." >&2
  exit 1
fi
echo "verify-upstream: GREEN — all readable references match upstream-refs.json."
exit 0
